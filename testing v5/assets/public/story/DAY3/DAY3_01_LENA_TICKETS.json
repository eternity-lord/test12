  "steps": [
    {"type":"notify","delay":1400,"fromId":"lena","fromName":"{{name:lena}}","avatar":"assets/avatars/lena.jpg","text":"Good morning ☀️","target":"conversation"},
    {"type":"send_to_continue","delay":900,"from":"player","text":"Hey you 🙂"},
    {"type":"message","delay":900,"from":"lena","text":"How are you feeling this morning?"},
    {"type":"message","delay":900,"from":"player","text":"I'm okay"},
    {"type":"message","delay":900,"from":"player","text":"What about you?"},
    {"type":"message","delay":950,"from":"lena","text":"I'm good 😊"},
    {"type":"message","delay":950,"from":"lena","text":"Still in bed actually 🛌"},
    {"type":"image","image":"assets/pictures/Conversation/lena_morning.jpg"},
    {"type":"message","delay":950,"from":"lena","text":"And what are you doing?"},
    {"type":"message","delay":900,"from":"player","text":"Playing on the PlayStation "},
    {"type":"message","delay":900,"from":"player","text":"Trying to wake up slowly"},
    {"type":"message","delay":950,"from":"lena","text":"Of course you are 😏"},
    {"type":"message","delay":950,"from":"lena","text":"I swear you never rest your thumbs"},
    {"type":"message","delay":900,"from":"player","text":"You're happy when my fingers are used to text you, no?"},
    {"type":"message","delay":950,"from":"lena","text":"That's true ❤️"},
    {"type":"message","delay":1000,"from":"lena","text":"By the way…"},
    {"type":"message","delay":1000,"from":"lena","text":"About the tickets for our trip"},
    {"type":"message","delay":950,"from":"lena","text":"I don't even know what to do with them now"},
    {"type":"message","delay":950,"from":"lena","text":"What do you think I should do?"},
    {"type":"choice","key":"d3_lena_tickets_choice_v2","options":[{"id":"love","text":"Give them to someone who really needs a break","points":{"love":2},"goto":"route_love"},{"id":"nts","text":"Keep them and why not go with {{name:aiden}}?","points":{"nts":2},"goto":"route_nts"},{"id":"ntr","text":"Keep them and find someone else to go with","points":{"ntr":2},"goto":"route_ntr"}]},
    {"type":"label","name":"route_love"},
    {"type":"set_flag","key":"memory_lena_tickets_v1","value":"love"},
    {"type":"message","delay":900,"from":"lena","text":"That's actually really kind of you 😊"},
    {"type":"message","delay":900,"from":"lena","text":"You always try to do the right thing"},
    {"type":"message","delay":900,"from":"player","text":"Of course I am, look at how much luck I have these days thanks to karma 😅"},
    {"type":"message","delay":900,"from":"lena","text":"Well having me as your girlfriend is not good enough?"},
    {"type":"message","delay":900,"from":"player","text":"It is! I'm the luckiest man in the world ❤️"},
    {"type":"message","delay":900,"from":"lena","text":"Really?"},
    {"type":"message","delay":900,"from":"player","text":"I swear"},
    {"type":"message","delay":900,"from":"lena","text":"I'm also the luckiest girl in the world"},
    {"type":"message","delay":900,"from":"player","text":"For having a vegetable as your man? Not sure about that 😄"},
    {"type":"message","delay":900,"from":"lena","text":"You know how much I love vegetables 😉"},
    {"type":"message","delay":900,"from":"lena","text":"You're too sweet"},
    {"type":"goto","label":"join_after_choice"},
    {"type":"label","name":"route_nts"},
    {"type":"set_flag","key":"memory_lena_tickets_v1","value":"nts"},
    {"type":"message","delay":900,"from":"lena","text":"With {{name:aiden}}?"},
    {"type":"message","delay":900,"from":"lena","text":"Why?"},
    {"type":"message","delay":900,"from":"player","text":"He always wanted to go to that island and at least he has his two legs"},
    {"type":"message","delay":900,"from":"lena","text":"I don't think I will be very comfortable going alone with him"},
    {"type":"message","delay":900,"from":"lena","text":"Even if he is my friend and your best friend, it feels weird no?"},
    {"type":"message","delay":900,"from":"player","text":"Now that you said it like that I guess it does"},
    {"type":"message","delay":900,"from":"player","text":"But I trust you both and I don't want you to miss the trip just because of me and at the same time he will finally have the trip to the island he wanted so much"},
    {"type":"message","delay":900,"from":"lena","text":"You're right I'm thinking too much"},
    {"type":"message","delay":900,"from":"lena","text":"And it is in more than a month so I got time to think about it"},
    {"type":"message","delay":900,"from":"player","text":"Exactly"},
    {"type":"message","delay":900,"from":"lena","text":"You won't be jealous?"},
    {"type":"message","delay":900,"from":"player","text":"Of course I will"},
    {"type":"message","delay":900,"from":"player","text":"My best friend going to the vacation we prepared and spending time with my girlfriend in my place, who on earth won't be jealous!"},
    {"type":"message","delay":900,"from":"lena","text":"That's true, and sweet it shows that you care a lot about me ❤️"},
    {"type":"message","delay":900,"from":"player","text":"That's called love"},
    {"type":"message","delay":900,"from":"lena","text":"You're too much of a sweet talker"},
    {"type":"message","delay":900,"from":"player","text":"Only with you ❤️"},
    {"type":"message","delay":900,"from":"lena","text":"You better 😌"},
    {"type":"goto","label":"join_after_choice"},
    {"type":"label","name":"route_ntr"},
    {"type":"set_flag","key":"memory_lena_tickets_v1","value":"ntr"},
    {"type":"message","delay":900,"from":"lena","text":"Someone else?"},
    {"type":"message","delay":900,"from":"lena","text":"That feels a little cold 😕"},
    {"type":"message","delay":900,"from":"player","text":"Sorry I didn't mean it that way"},
    {"type":"message","delay":900,"from":"player","text":"It's more like you need to find someone else who would like to go to the island with you so you can enjoy the trip even if it's not with me"},
    {"type":"message","delay":900,"from":"lena","text":"Yeah…"},
    {"type":"message","delay":900,"from":"player","text":"You're upset?"},
    {"type":"message","delay":900,"from":"lena","text":"No"},
    {"type":"message","delay":900,"from":"lena","text":"I mean I just wasn't expecting you to say something like that"},
    {"type":"message","delay":900,"from":"player","text":"Why? I did not mean it in a bad way"},
    {"type":"message","delay":900,"from":"lena","text":"I know sorry I made a big deal out of nothing"},
    {"type":"message","delay":900,"from":"lena","text":"It's just that I'm sad that I won't go with you"},
    {"type":"message","delay":900,"from":"player","text":"Me too and you know it"},
    {"type":"message","delay":900,"from":"player","text":"But next time as soon as I'm healed we will go together ❤️"},
    {"type":"message","delay":900,"from":"lena","text":"I hope so"},
    {"type":"message","delay":900,"from":"player","text":"Promise"},
    {"type":"goto","label":"join_after_choice"},
    {"type":"label","name":"join_after_choice"},
    {"type":"label","name":"join_after_intimacy_choice"},
    {"type":"message","delay":900,"from":"lena","text":"Also"},
    {"type":"message","delay":900,"from":"lena","text":"I’m coming over today"},
    {"type":"message","delay":900,"from":"lena","text":"Sasha and I postponed our plans, so I can spend the day with you 😌"},
    {"type":"message","delay":900,"from":"player","text":"You really don’t have to come all the way here on your only day off"},
    {"type":"message","delay":900,"from":"player","text":"I don’t want you to feel like you have to"},
    {"type":"message","delay":900,"from":"lena","text":"I know"},
    {"type":"message","delay":900,"from":"lena","text":"But I want to"},
    {"type":"message","delay":900,"from":"lena","text":"I miss you"},
    {"type":"message","delay":900,"from":"lena","text":"And I’d come anyway even if you tried to stop me 😌"},
    {"type":"message","delay":900,"from":"player","text":"Thank you"},
    {"type":"message","delay":900,"from":"player","text":"That really means a lot"},
    {"type":"message","delay":900,"from":"lena","text":"See you in half an hour ❤️"},

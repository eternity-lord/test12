    {"type":"message","delay":900,"from":"tutor","text":"She even said she might fail a quiz on purpose if the punishment is not extra exercises"},
    {"type":"message","delay":900,"from":"player","text":"That sounds exactly like {{name:hailey}}"},
    {"type":"message","delay":900,"from":"tutor","text":"I wanted to ask how you would prefer me to react"},
    {"type":"message","delay":900,"from":"player","text":"Act how you think is best"},
    {"type":"message","delay":900,"from":"player","text":"As long as she passes her exams, I don't really care"},
    {"type":"message","delay":900,"from":"player","text":"Just know she's very teasing"},
    {"type":"message","delay":900,"from":"player","text":"She does it on purpose"},
    {"type":"message","delay":900,"from":"tutor","text":"Understood"},
    {"type":"message","delay":900,"from":"tutor","text":"Do you still want me to keep you informed about everything?"},
    {"type":"message","delay":900,"from":"player","text":"Yes"},
    {"type":"message","delay":900,"from":"player","text":"I want to know how things are going"},
    {"type":"message","delay":900,"from":"tutor","text":"Perfect"},
    {"type":"message","delay":900,"from":"tutor","text":"Then I'll be transparent with you"},
    {"type":"message","delay":900,"from":"tutor","text":"She passed the last quiz"},
    {"type":"message","delay":900,"from":"tutor","text":"So she asked for her reward"},
    {"type":"message","delay":900,"from":"player","text":"What did she ask for this time?"},
    {"type":"message","delay":900,"from":"tutor","text":"She asked if she could sit on my lap while we finish the last part of the session"},
    {"type":"photo","delay":900,"from":"tutor","image":"assets/pictures/Conversation/hailey_sitting_on_tutor.jpg"},
    {"type":"message","delay":900,"from":"tutor","text":"Are you okay with that?"},
    {"type":"message","delay":900,"from":"player","text":"If she earned it, it's fine"},
    {"type":"message","delay":900,"from":"player","text":"But make sure she still finishes the work"},
    {"type":"message","delay":900,"from":"tutor","text":"Of course"},
    {"type":"message","delay":900,"from":"tutor","text":"The study goal stays the priority"}

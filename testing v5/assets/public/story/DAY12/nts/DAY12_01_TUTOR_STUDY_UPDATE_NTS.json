    {"type":"message","delay":900,"from":"tutor","text":"She still jokes a lot, but she understands faster than yesterday"},
    {"type":"message","delay":900,"from":"player","text":"That's good"},
    {"type":"message","delay":900,"from":"tutor","text":"She has courage too"},
    {"type":"message","delay":900,"from":"tutor","text":"Even when she's embarrassed about not understanding something, she keeps trying"},
    {"type":"message","delay":900,"from":"player","text":"Yeah, that's her"},
    {"type":"message","delay":900,"from":"tutor","text":"There is one thing though"},

      {"type":"message","delay":900,"from":"hailey","text":"You do?"},
      {"type":"message","delay":900,"from":"player","text":"He texted me yesterday"},
      {"type":"message","delay":900,"from":"hailey","text":"Where is it happening?"},
      {"type":"message","delay":900,"from":"player","text":"In his private gym"},
      {"type":"message","delay":900,"from":"hailey","text":"…"},
      {"type":"message","delay":900,"from":"hailey","text":"I forgot he was rich 😭"},
      {"type":"message","delay":900,"from":"player","text":"Easy to forget when he's always in sportswear"},

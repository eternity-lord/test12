    {"type":"message","delay":900,"from":"player","text":"Anyway"},
    {"type":"message","delay":900,"from":"player","text":"I made breakfast"},
    {"type":"message","delay":900,"from":"player","text":"You can come down whenever you want"},
    {"type":"message","delay":900,"from":"hailey","text":"Oh?"},

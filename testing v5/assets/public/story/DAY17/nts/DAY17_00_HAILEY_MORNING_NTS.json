      {"type":"message","delay":900,"from":"player","text":"You're unbelievable"},
      {"type":"message","delay":900,"from":"hailey","text":"And yet you're the one who suggested I keep him"}
    ],"else":[
      {"type":"message","delay":900,"from":"hailey","text":"I can't wait to finally have my diploma in my hands"},
      {"type":"message","delay":900,"from":"hailey","text":"But right now…"},
      {"type":"message","delay":900,"from":"hailey","text":"I mostly want my summer body"},
      {"type":"message","delay":900,"from":"player","text":"That comment yesterday really got to you, huh?"},
      {"type":"message","delay":900,"from":"hailey","text":"A little"},
      {"type":"message","delay":900,"from":"hailey","text":"I want to look good in a bikini this summer"},
      {"type":"message","delay":900,"from":"hailey","text":"So I need to start now"},

    {"type":"meetandgreet_notify","text":"Additional Noah date content unlocked.","profileId":"noah","onceKey":"meetandgreet_d13_noah_update_v1"},
    {"type":"message","delay":850,"from":"player","text":"Go take a shower quickly"},
    {"type":"message","delay":850,"from":"player","text":"I don't want you catching a cold"},

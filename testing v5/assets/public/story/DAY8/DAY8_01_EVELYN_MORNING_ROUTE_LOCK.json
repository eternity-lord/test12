  "steps": [
    {"type":"notify","delay":1200,"fromId":"evelyn","fromName":"{{name:evelyn}}","avatar":"assets/avatars/evelyn.jpg","text":"Can we talk?","target":"conversation"},
    {"type":"message","delay":900,"from":"evelyn","text":"I saw your messages"},
    {"type":"message","delay":900,"from":"evelyn","text":"I did not answer because it was too late"},
    {"type":"message","delay":900,"from":"evelyn","text":"It is getting harder there"},
    {"type":"message","delay":900,"from":"evelyn","text":"My manager is making it difficult for me"},
    {"type":"message","delay":900,"from":"player","text":"Again?"},
    {"type":"message","delay":900,"from":"evelyn","text":"Yes"},
    {"type":"message","delay":900,"from":"evelyn","text":"He watches me like I owe him something"},
    {"type":"message","delay":900,"from":"evelyn","text":"I hate that place"},
    {"type":"message","delay":900,"from":"evelyn","text":"But I also hate feeling like a burden to you"},
    {"type":"message","delay":900,"from":"player","text":"You are not a burden"},
    {"type":"message","delay":900,"from":"player","text":"We need to find a solution"},
    {"type":"message","delay":900,"from":"evelyn","text":"Then tell me what you want me to do"},
    {"type":"message","delay":900,"from":"evelyn","text":"Because we still need money"},
    {"type":"hak_hint","kind":"love","text":"Commitment choice detected, your answer will permanently lock {{name:evelyn}} into a stable route","onceKey":"d8_evelyn_love_lock_hint_once"},
    {"type":"hak_hint","kind":"nts","text":"Commitment choice detected, your answer will permanently lock {{name:evelyn}} into a shared tension route","onceKey":"d8_evelyn_nts_lock_hint_once"},
    {"type":"hak_hint","kind":"ntr","text":"Commitment choice detected, your answer will permanently lock {{name:evelyn}} into a high risk route","onceKey":"d8_evelyn_ntr_lock_hint_once"},
    {"type":"choice","key":"d8_evelyn_route_lock_choice_v1","prompt":"","options":[{"id":"ntr","text":"Keep working there for now","goto":"lock_ntr","points":{"ntr":2}},{"id":"nts","text":"We find a safer plan together","goto":"lock_nts","points":{"nts":2}},{"id":"love","text":"I will find a job, something I can do from home","goto":"lock_love","points":{"love":2}}]},
    {"type":"label","name":"lock_love"},
    {"type":"set_flag","key":"route_evelyn_locked_v1","value":"love","onceKey":"d8_route_day9_love_locked_v1"},
    {"type":"set_flag","key":"route_evelyn_lock_day_v1","value":"8"},
    {"type":"message","delay":900,"from":"evelyn","text":"You should not do that alone"},
    {"type":"message","delay":900,"from":"player","text":"I will handle it"},
    {"type":"message","delay":900,"from":"player","text":"You do not need to suffer there"},
    {"type":"message","delay":900,"from":"evelyn","text":"Are you really sure?"},
    {"type":"message","delay":900,"from":"player","text":"Of course I am"},
    {"type":"message","delay":900,"from":"player","text":"I know someone"},
    {"type":"message","delay":900,"from":"player","text":"If I bribe him a little he should find me something quickly"},
    {"type":"message","delay":900,"from":"player","text":"So do not worry"},
    {"type":"message","delay":900,"from":"evelyn","text":"Fine"},
    {"type":"message","delay":900,"from":"evelyn","text":"Then I will stay home"},
    {"type":"message","delay":900,"from":"evelyn","text":"But I will take care of you even more"},
    {"type":"message","delay":900,"from":"player","text":"Is that even possible?"},
    {"type":"message","delay":900,"from":"evelyn","text":"Of course it is"},
    {"type":"message","delay":900,"from":"evelyn","text":"You will see"},
    {"type":"goto","label":"end"},
    {"type":"label","name":"lock_nts"},
    {"type":"set_flag","key":"route_evelyn_locked_v1","value":"nts","onceKey":"d8_route_day9_nts_locked_v1"},
    {"type":"set_flag","key":"route_evelyn_lock_day_v1","value":"8"},
    {"type":"message","delay":900,"from":"evelyn","text":"A safer plan?"},
    {"type":"message","delay":900,"from":"player","text":"Yes"},
    {"type":"message","delay":900,"from":"player","text":"Give me one or two days and I will find something"},
    {"type":"message","delay":900,"from":"player","text":"In the meantime, just say you are sick"},
    {"type":"message","delay":900,"from":"player","text":"No more bars"},
    {"type":"message","delay":900,"from":"evelyn","text":"I do not want you to carry everything"},
    {"type":"message","delay":900,"from":"evelyn","text":"Are you really sure?"},
    {"type":"message","delay":900,"from":"evelyn","text":"I can still work there"},
    {"type":"message","delay":900,"from":"evelyn","text":"It will just be difficult"},
    {"type":"message","delay":900,"from":"player","text":"I said no"},
    {"type":"message","delay":900,"from":"player","text":"I will find a way"},
    {"type":"message","delay":900,"from":"player","text":"Do not worry"},
    {"type":"message","delay":900,"from":"player","text":"A few days will not kill us"},
    {"type":"message","delay":900,"from":"player","text":"We are not that poor yet"},
    {"type":"message","delay":900,"from":"player","text":"I still have the money I saved for the trip"},
    {"type":"message","delay":900,"from":"evelyn","text":"Keep that money"},
    {"type":"message","delay":900,"from":"evelyn","text":"It is yours"},
    {"type":"message","delay":900,"from":"player","text":"I will use it if we need to"},
    {"type":"message","delay":900,"from":"player","text":"But I do not think we will"},
    {"type":"message","delay":900,"from":"player","text":"I just need the right opportunity"},
    {"type":"message","delay":900,"from":"evelyn","text":"Alright"},
    {"type":"message","delay":900,"from":"evelyn","text":"Then I will not go back tonight"},
    {"type":"message","delay":900,"from":"evelyn","text":"But tell me quickly when you find something for me"},
    {"type":"message","delay":900,"from":"player","text":"Yes {{name:evelyn}}"},
    {"type":"goto","label":"end"},
    {"type":"label","name":"lock_ntr"},
    {"type":"set_flag","key":"route_evelyn_locked_v1","value":"ntr","onceKey":"d8_route_day9_ntr_locked_v1"},
    {"type":"set_flag","key":"route_evelyn_lock_day_v1","value":"8"},
    {"type":"message","delay":900,"from":"evelyn","text":"Okay"},
    {"type":"message","delay":900,"from":"evelyn","text":"I will go"},
    {"type":"message","delay":900,"from":"evelyn","text":"I just have to bear with him"},
    {"type":"message","delay":900,"from":"evelyn","text":"How hard can it be?"},
    {"type":"message","delay":900,"from":"player","text":"I know it is not the best"},
    {"type":"message","delay":900,"from":"player","text":"But I cannot help you yet"},
    {"type":"message","delay":900,"from":"player","text":"As soon as I can walk again I will work"},
    {"type":"message","delay":900,"from":"player","text":"And you will be able to leave"},
    {"type":"message","delay":900,"from":"player","text":"I am sorry you have to endure him"},
    {"type":"message","delay":900,"from":"player","text":"If he gets too annoying just kick him in the balls"},
    {"type":"message","delay":900,"from":"evelyn","text":"Not a bad idea"},
    {"type":"message","delay":900,"from":"evelyn","text":"But I would get fired"},
    {"type":"message","delay":900,"from":"evelyn","text":"So not for now"},
    {"type":"message","delay":900,"from":"evelyn","text":"But maybe someday"},
    {"type":"label","name":"end"}
  ]

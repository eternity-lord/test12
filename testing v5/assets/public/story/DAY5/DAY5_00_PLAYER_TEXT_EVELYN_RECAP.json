  "steps": [
    {"type":"message","delay":900,"from":"player","text":"How was yesterday?"},
    {"type":"message","delay":900,"from":"evelyn","text":"Long"},
    {"type":"message","delay":900,"from":"evelyn","text":"I had forgotten how exhausting it can be"},
    {"type":"message","delay":900,"from":"evelyn","text":"But it felt good to be back"},
    {"type":"message","delay":900,"from":"player","text":"And that manager?"},
    {"type":"message","delay":900,"from":"player","text":"Is he still there?"},
    {"type":"message","delay":900,"from":"evelyn","text":"Yes"},
    {"type":"message","delay":900,"from":"evelyn","text":"I saw him during the evening"},
    {"type":"message","delay":900,"from":"evelyn","text":"He seemed calmer"},
    {"type":"message","delay":900,"from":"evelyn","text":"He was actually very polite"},
    {"type":"message","delay":900,"from":"evelyn","text":"Almost too polite"},
    {"type":"message","delay":900,"from":"player","text":"That sounds suspicious"},
    {"type":"message","delay":900,"from":"evelyn","text":"Maybe"},
    {"type":"message","delay":900,"from":"evelyn","text":"Or maybe he just understood boundaries this time"},
    {"type":"message","delay":900,"from":"player","text":"I hope so"},
    {"type":"message","delay":900,"from":"evelyn","text":"Do not worry"},
    {"type":"message","delay":900,"from":"evelyn","text":"I can handle myself"},
    {"type":"message","delay":900,"from":"player","text":"I know"},
    {"type":"message","delay":900,"from":"player","text":"You did well?"},
    {"type":"message","delay":900,"from":"evelyn","text":"I think so"},
    {"type":"message","delay":900,"from":"evelyn","text":"I was a little slow at first"},
    {"type":"message","delay":900,"from":"evelyn","text":"But muscle memory comes back quickly"},
    {"type":"message","delay":900,"from":"player","text":"I'm proud of you"},
    {"type":"message","delay":900,"from":"evelyn","text":"That means a lot"},
    {"type":"message","delay":900,"from":"evelyn","text":"And you, how was your day?"},
    {"type":"message","delay":900,"from":"player","text":"Quiet"},
    {"type":"message","delay":900,"from":"player","text":"I mostly rested"},
    {"type":"message","delay":900,"from":"evelyn","text":"Good"},
    {"type":"message","delay":900,"from":"evelyn","text":"I'm going to prepare dinner earlier today, tell me when you're hungry, I will bring it to you directly"},
    {"type":"message","delay":900,"from":"player","text":"Thank you"}
  ]
}

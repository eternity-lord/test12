  "steps": [
    {"type":"notify","delay":800,"fromId":"hailey","fromName":"{{name:hailey}}","avatar":"assets/avatars/hailey.jpg","text":"I'm bored 😩","target":"conversation"},
    {"type":"message","delay":900,"from":"hailey","text":"What are you doing?"},
    {"type":"message","delay":900,"from":"player","text":"Trying to enjoy a peaceful afternoon"},
    {"type":"message","delay":900,"from":"hailey","text":"So nothing important"},
    {"type":"message","delay":900,"from":"player","text":"Exactly"},
    {"type":"message","delay":900,"from":"hailey","text":"How's the leg?"},
    {"type":"message","delay":900,"from":"player","text":"Better and better"},
    {"type":"message","delay":900,"from":"hailey","text":"Good"},
    {"type":"message","delay":900,"from":"hailey","text":"You need to get better soon"},
    {"type":"message","delay":900,"from":"hailey","text":"I miss making fun of the way you walk 😌"},
    {"type":"message","delay":900,"from":"player","text":"Such kindness"},
    {"type":"message","delay":900,"from":"hailey","text":"I know 😊"},
    {"type":"message","delay":900,"from":"hailey","text":"Anyway"},
    {"type":"message","delay":900,"from":"hailey","text":"I walked past a clothing store after class"},
    {"type":"message","delay":900,"from":"player","text":"And?"},
    {"type":"message","delay":900,"from":"hailey","text":"And they had a huge sale 😭"},
    {"type":"message","delay":900,"from":"hailey","text":"Do you know how hard it was not to go inside?"},
    {"type":"message","delay":900,"from":"player","text":"You say that like it's a real struggle"},
    {"type":"message","delay":900,"from":"hailey","text":"It IS a real struggle"},
    {"type":"message","delay":900,"from":"hailey","text":"You wouldn't understand"},
    {"type":"message","delay":900,"from":"player","text":"Your shopping addiction needs professional treatment"},
    {"type":"message","delay":900,"from":"hailey","text":"Rude 😭"},
    {"type":"message","delay":900,"from":"hailey","text":"At least my clothes look good"},
    {"type":"message","delay":900,"from":"hailey","text":"Look"},
    {"type":"photo","delay":900,"from":"hailey","image":"assets/pictures/Conversation/hailey_day9_shopping.jpg"},
    {"type":"message","delay":900,"from":"hailey","text":"Cute, right? 😌"},
    {"type":"message","delay":900,"from":"player","text":"You were definitely planning to buy it"},
    {"type":"message","delay":900,"from":"hailey","text":"Maybe"},
    {"type":"message","delay":900,"from":"hailey","text":"That's not the point"},
    {"type":"message","delay":900,"from":"player","text":"Sure"},
    {"type":"message","delay":900,"from":"hailey","text":"Speaking of professional help..."},
    {"type":"message","delay":900,"from":"hailey","text":"Any news about that {{name:tutor}}?"},
    {"type":"message","delay":900,"from":"player","text":"Actually yes"},
    {"type":"message","delay":900,"from":"player","text":"I should have an answer sometime today"},
    {"type":"message","delay":900,"from":"hailey","text":"Oh?"},
    {"type":"message","delay":900,"from":"hailey","text":"That fast?"},
    {"type":"message","delay":900,"from":"player","text":"Looks like it"},
    {"type":"message","delay":900,"from":"player","text":"I'll let you know as soon as I hear back"},
    {"type":"message","delay":900,"from":"hailey","text":"Now I'm curious 😶"},
    {"type":"message","delay":900,"from":"hailey","text":"Please don't hire some terrifying genius"},
    {"type":"message","delay":900,"from":"player","text":"No promises"},
    {"type":"message","delay":900,"from":"hailey","text":"😭"},
    {"type":"message","delay":900,"from":"hailey","text":"Keep me updated then"},
    {"type":"message","delay":900,"from":"player","text":"Will do"},
    {"type":"if","condition":"active_character:lena","then":[
      {"type":"start_story","goHome":true,"startStory":"story/DAY9/nts/DAY9_05_TUTOR_SEARCH_NTS.json","startDelayMs":200}

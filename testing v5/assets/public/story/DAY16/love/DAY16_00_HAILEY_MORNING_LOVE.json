    {"type":"hak_overlay","title":"HAK//SKILL AVAILABLE","skillId":"love_audio_transcription_v1","messages":["Sufficient HAK points accumulated","New skill available: Live Transcription","Captures conversations happening elsewhere by monitoring persons of interest"]},
    {"type":"notify","delay":1600,"fromId":"hailey","fromName":"{{name:hailey}}","avatar":"assets/avatars/hailey.jpg","text":"Good morning","target":"conversation"},
    {"type":"message","delay":1300,"from":"hailey","text":"I tried the outfit you chose for me again this morning"},
    {"type":"message","delay":1200,"from":"hailey","text":"And I still can’t decide if I should thank you or be slightly annoyed"},
    {"type":"message","delay":1400,"from":"hailey","text":"It looks better than I expected"},
    {"type":"choice","key":"d16_morning_outfit_v1","options":[{"id":"soft_1","text":"I’m glad you like it","goto":"outfit_soft"},{"id":"soft_2","text":"You should wear it today","goto":"outfit_encourage"},{"id":"tease","text":"Told you I had decent taste","goto":"outfit_tease"}]},
    {"type":"label","name":"outfit_soft"},
    {"type":"message","delay":1400,"from":"hailey","text":"Don’t sound so pleased with yourself"},
    {"type":"message","delay":1300,"from":"hailey","text":"It’s just an outfit"},
    {"type":"goto","label":"after_outfit"},
    {"type":"label","name":"outfit_encourage"},
    {"type":"message","delay":1400,"from":"hailey","text":"Maybe I will"},
    {"type":"message","delay":1300,"from":"hailey","text":"If I feel like drawing a bit of attention"},
    {"type":"goto","label":"after_outfit"},
    {"type":"label","name":"outfit_tease"},
    {"type":"message","delay":1400,"from":"hailey","text":"Don’t get used to being right"},
    {"type":"message","delay":1300,"from":"hailey","text":"It’s a dangerous habit"},
    {"type":"goto","label":"after_outfit"},
    {"type":"label","name":"after_outfit"},
    {"type":"message","delay":1600,"from":"hailey","text":"Anyway"},
    {"type":"message","delay":1400,"from":"hailey","text":"I’ve been thinking about last night"},
    {"type":"message","delay":1500,"from":"hailey","text":"More than I wanted to"},
    {"type":"message","delay":1600,"from":"player","text":"Which part?"},
    {"type":"message","delay":1500,"from":"hailey","text":"You know which part"},
    {"type":"message","delay":1400,"from":"hailey","text":"The photo"},
    {"type":"message","delay":1500,"from":"hailey","text":"I keep wondering what you actually thought when you received it"},
    {"type":"choice","key":"d16_morning_photos_v1","options":[{"id":"honest","text":"I thought about it more than I should have","goto":"photos_honest"},{"id":"calm","text":"You looked good in it","goto":"photos_calm"}]},
    {"type":"label","name":"photos_honest"},
    {"type":"message","delay":1600,"from":"hailey","text":"..."},
    {"type":"message","delay":1500,"from":"hailey","text":"That’s more honest than I expected"},
    {"type":"message","delay":1400,"from":"hailey","text":"I don’t know if that makes it better or worse"},
    {"type":"goto","label":"after_photos"},
    {"type":"label","name":"photos_calm"},
    {"type":"message","delay":1500,"from":"hailey","text":"That’s all?"},
    {"type":"message","delay":1400,"from":"hailey","text":"You’re still being careful"},
    {"type":"goto","label":"after_photos"},
    {"type":"label","name":"after_photos"},
    {"type":"message","delay":1700,"from":"hailey","text":"I keep telling myself it was just a stupid late-night decision"},
    {"type":"message","delay":1500,"from":"hailey","text":"But I didn’t exactly regret sending it either"},
    {"type":"message","delay":1600,"from":"hailey","text":"That’s the part that bothers me"},
    {"type":"message","delay":1700,"from":"player","text":"Why does it bother you?"},
    {"type":"message","delay":1600,"from":"hailey","text":"Because it means I wanted you to see me like that"},
    {"type":"message","delay":1500,"from":"hailey","text":"And I don’t usually do things like that without overthinking for days"},
    {"type":"message","delay":1600,"from":"hailey","text":"It just… happened"},
    {"type":"message","delay":1700,"from":"player","text":"I’m not complaining at all"},
    {"type":"message","delay":1500,"from":"hailey","text":"I know"},
    {"type":"message","delay":1400,"from":"hailey","text":"That’s also part of the problem"},
    {"type":"message","delay":1600,"from":"hailey","text":"You’re being very calm about something that still feels a bit dangerous to me"},
        {"type":"message","delay":1700,"from":"player","text":"I'm not that calm either"},
    {"type":"message","delay":1700,"from":"player","text":"And dangerous how?"},
    {"type":"message","delay":1600,"from":"hailey","text":"We’re living in the same house"},
    {"type":"message","delay":1500,"from":"hailey","text":"If things start changing, they change fast"},
    {"type":"message","delay":1600,"from":"hailey","text":"And I’m not sure I’m ready for that yet"},
    {"type":"message","delay":1800,"from":"player","text":"We don’t have to rush anything"},
    {"type":"message","delay":1600,"from":"hailey","text":"..."},
    {"type":"message","delay":1500,"from":"hailey","text":"That’s a decent answer"},
    {"type":"message","delay":1400,"from":"hailey","text":"I needed to hear that"},
    {"type":"message","delay":1600,"from":"hailey","text":"Okay, I’m going to get ready before I keep talking myself into a corner"},
    {"type":"message","delay":1400,"from":"hailey","text":"Talk later?"},
    {"type":"message","delay":1200,"from":"player","text":"Sure"}
  ]

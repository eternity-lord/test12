  "steps": [
    {"type":"notify","delay":1300,"fromId":"lena","fromName":"{{name:lena}}","avatar":"assets/avatars/lena.jpg","text":"Update: lunch was great","target":"conversation"},
    {"type":"message","delay":900,"from":"lena","text":"The cards are a disaster"},
    {"type":"message","delay":900,"from":"player","text":"Already?"},
    {"type":"message","delay":900,"from":"lena","text":"I've lost twice"},
    {"type":"message","delay":900,"from":"lena","text":"Everyone suddenly becomes very competitive when I'm about to win"},
    {"type":"message","delay":900,"from":"player","text":"Including you?"},
    {"type":"message","delay":900,"from":"lena","text":"That's different"},
    {"type":"image","delay":900,"from":"lena","image":"assets/pictures/Conversation/lena_day17_family_game.jpg"},
    {"type":"message","delay":900,"from":"lena","text":"Look at the face of someone being treated unfairly"},
    {"type":"message","delay":900,"from":"player","text":"You look like you're planning revenge"},
    {"type":"message","delay":900,"from":"player","text":"Say hello to your mom for me"},
    {"type":"message","delay":900,"from":"lena","text":"She sends you a kiss back 😘"},
    {"type":"message","delay":900,"from":"lena","text":"Help me"},
    {"type":"message","delay":900,"from":"player","text":"What's happening?"},
    {"type":"message","delay":900,"from":"lena","text":"I've nearly finished my cards"},
    {"type":"message","delay":900,"from":"lena","text":"But every time I look pleased, someone makes me draw more"},
    {"type":"message","delay":900,"from":"player","text":"Then stop looking pleased"},
    {"type":"message","delay":900,"from":"player","text":"Act like your hand is terrible"},
    {"type":"message","delay":900,"from":"lena","text":"That's your brilliant advice?"},
    {"type":"message","delay":900,"from":"player","text":"Let them underestimate you"},
    {"type":"message","delay":900,"from":"lena","text":"Fine. I'm trusting you with my reputation"},
    {"type":"note","delay":1400,"text":"A FEW MINUTES LATER"},
    {"type":"message","delay":900,"from":"lena","text":"I lost again"},
    {"type":"message","delay":900,"from":"player","text":"Did you keep a straight face?"},
    {"type":"message","delay":900,"from":"lena","text":"For about ten seconds"},
    {"type":"message","delay":900,"from":"lena","text":"Then someone asked why I looked like I was hiding a crime"},
    {"type":"message","delay":900,"from":"player","text":"So the bluff needs work"},
    {"type":"message","delay":900,"from":"lena","text":"I think I need a new adviser"},
    {"type":"message","delay":900,"from":"player","text":"Harsh. I was working with limited information"},
    {"type":"message","delay":900,"from":"lena","text":"They asked who I kept texting"},
    {"type":"message","delay":900,"from":"player","text":"Did you tell them you were receiving expert assistance?"},
    {"type":"message","delay":900,"from":"lena","text":"I said my boyfriend was helping me lose"},
    {"type":"message","delay":900,"from":"player","text":"That hurts"},
    {"type":"message","delay":900,"from":"lena","text":"Only because it's accurate 😌"},
    {"type":"message","delay":900,"from":"player","text":"You should give them a chance to miss you. Take a break"},
    {"type":"message","delay":900,"from":"lena","text":"I have. I'm getting another slice of cake"},
    {"type":"message","delay":900,"from":"lena","text":"At least I'm winning at dessert"},
    {"type":"message","delay":900,"from":"player","text":"A strong recovery"},
    {"type":"message","delay":900,"from":"lena","text":"I'll be home later this afternoon"},
    {"type":"message","delay":900,"from":"lena","text":"Are you free tonight?"},
    {"type":"message","delay":900,"from":"player","text":"Yeah. Why?"},
    {"type":"message","delay":900,"from":"lena","text":"I have an idea. I'll tell you when I'm home ❤️"},
    {"type":"message","delay":900,"from":"player","text":"Now I'm curious"},
    {"type":"message","delay":900,"from":"lena","text":"Good. Let me finish my very important cake first"}
  ]
}

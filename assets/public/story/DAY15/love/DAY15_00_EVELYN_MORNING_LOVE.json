  "steps": [
    {"type":"notify","delay":1200,"fromId":"evelyn","fromName":"{{name:evelyn}}","avatar":"assets/avatars/evelyn.jpg","text":"Good morning 😊","target":"conversation"},
    {"type":"message","delay":850,"from":"evelyn","text":"How are you feeling today?"},
    {"type":"message","delay":850,"from":"evelyn","text":"You're not too tired?"},
    {"type":"message","delay":850,"from":"evelyn","text":"We went to bed pretty late yesterday"},
    {"type":"message","delay":850,"from":"player","text":"I'm fine"},
    {"type":"message","delay":850,"from":"player","text":"I slept very well actually"},
    {"type":"message","delay":850,"from":"player","text":"What about you?"},
    {"type":"message","delay":850,"from":"player","text":"Did you sleep well?"},
    {"type":"message","delay":850,"from":"evelyn","text":"I slept alright"},
    {"type":"message","delay":850,"from":"evelyn","text":"I woke up a few times during the night"},
    {"type":"message","delay":850,"from":"evelyn","text":"But I think I got enough rest"},
    {"type":"message","delay":850,"from":"player","text":"That's good"},
    {"type":"message","delay":850,"from":"player","text":"By the way, I sent you some money this morning"},
    {"type":"message","delay":850,"from":"player","text":"For groceries, bills and everything else"},
    {"type":"message","delay":850,"from":"evelyn","text":"You did?"},
    {"type":"message","delay":850,"from":"evelyn","text":"I really don't know how to thank you"},
    {"type":"message","delay":850,"from":"player","text":"You already do enough for me"},
    {"type":"message","delay":850,"from":"player","text":"You've done so much already"},
    {"type":"message","delay":850,"from":"player","text":"You deserve to rest and enjoy yourself a little"},
    {"type":"message","delay":850,"from":"player","text":"And honestly, I'm happy I get to spend so much time with you lately"},
    {"type":"message","delay":850,"from":"player","text":"It feels like we've gotten a lot closer"},
    {"type":"message","delay":850,"from":"evelyn","text":"I'm happy too"},
    {"type":"message","delay":850,"from":"evelyn","text":"I like spending more time with you"},
    {"type":"message","delay":850,"from":"evelyn","text":"More than I expected, actually 😌"},
    {"type":"message","delay":850,"from":"evelyn","text":"Anyway, don't forget"},
    {"type":"message","delay":850,"from":"evelyn","text":"The doctor is coming after work today"},
    {"type":"message","delay":850,"from":"evelyn","text":"So be ready for that"},
    {"type":"message","delay":850,"from":"player","text":"That should be fine"},
    {"type":"message","delay":850,"from":"player","text":"Actually, I wanted to ask you something"},
    {"type":"message","delay":850,"from":"player","text":"Would it be easier if I kept some food in my room for lunch?"},
    {"type":"message","delay":850,"from":"player","text":"That way I wouldn't have to bother you every day"},
    {"type":"message","delay":850,"from":"evelyn","text":"You're not bothering me"},
    {"type":"message","delay":850,"from":"evelyn","text":"Not even a little"},
    {"type":"message","delay":850,"from":"evelyn","text":"I actually like taking care of you"},
    {"type":"message","delay":850,"from":"evelyn","text":"So whenever you're hungry, just tell me"},
    {"type":"message","delay":850,"from":"evelyn","text":"And I'll bring you a hot meal"},
    {"type":"message","delay":850,"from":"player","text":"Thank you, {{name:evelyn}}"},
    {"type":"message","delay":850,"from":"player","text":"I'll talk to you later then"},
    {"type":"message","delay":850,"from":"evelyn","text":"Good luck with work 😊"},
    {"type":"start_story","goHome":true,"startStory":"story/DAY15/love/DAY15_01_EVELYN_AFTERNOON_LOVE.json"}

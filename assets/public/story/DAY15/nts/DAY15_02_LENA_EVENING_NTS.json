{
  "onceKey": "d15_01_lena_afternoon_nts_v1",
  "contactId": "lena",
  "requireOnceKey": "d15_00_lena_morning_nts_v1",
  "onCompleteStartStory": "story/DAY15/DAY15_02_HAILEY_EVENING.json",
  "steps": [
    {"type":"notify","delay":1300,"fromId":"lena","fromName":"{{name:lena}}","avatar":"assets/avatars/lena.jpg","text":"Home 😮‍💨","target":"conversation"},
    {"type":"message","delay":900,"from":"player","text":"Back already?"},
    {"type":"message","delay":900,"from":"lena","text":"Finally, you mean!"},
    {"type":"message","delay":900,"from":"lena","text":"That day felt so long"},
    {"type":"message","delay":900,"from":"player","text":"Bad day?"},
    {"type":"message","delay":900,"from":"lena","text":"Just exhausting"},
    {"type":"message","delay":900,"from":"lena","text":"Too many classes, too many people 😭"},
    {"type":"message","delay":900,"from":"player","text":"Sounds fun"},
    {"type":"message","delay":900,"from":"lena","text":"You're making fun of me"},
    {"type":"message","delay":900,"from":"player","text":"Maybe a little"},
    {"type":"message","delay":900,"from":"lena","text":"Rude 😌"},
    {"type":"message","delay":900,"from":"lena","text":"What about you?"},
    {"type":"message","delay":900,"from":"player","text":"Doctor came by today"},
    {"type":"message","delay":900,"from":"lena","text":"Oh??"},
    {"type":"message","delay":900,"from":"player","text":"I have good news"},
    {"type":"message","delay":900,"from":"lena","text":"Don't play with me"},
    {"type":"message","delay":900,"from":"player","text":"The doctor removed the cast today"},
    {"type":"message","delay":900,"from":"lena","text":"Wait, really??"},
    {"type":"message","delay":900,"from":"lena","text":"That's amazing ❤️"},
    {"type":"message","delay":900,"from":"lena","text":"I'm so happy for you"},
    {"type":"message","delay":900,"from":"player","text":"Me too"},
    {"type":"message","delay":900,"from":"lena","text":"Mhm ❤️"},
    {"type":"message","delay":900,"from":"lena","text":"Okay I need a shower now"},
    {"type":"message","delay":900,"from":"player","text":"Can I get something after?"},
    {"type":"message","delay":900,"from":"lena","text":"You're predictable"},
    {"type":"message","delay":900,"from":"player","text":"You like it"},
    {"type":"message","delay":900,"from":"lena","text":"Maybe 😌"},
    {"type":"message","delay":900,"from":"lena","text":"Let me shower first"},
    {"type":"note","text":"12 MINUTES LATER"},
    {"type":"message","delay":900,"from":"lena","text":"I'm back"},
    {"type":"message","delay":900,"from":"lena","text":"Still want your picture?"},
    {"type":"message","delay":900,"from":"player","text":"Always"},
    {"type":"message","delay":900,"from":"lena","text":"Or…"},
    {"type":"message","delay":900,"from":"lena","text":"Do you want me to send it to someone else instead?"},
    {"type":"message","delay":900,"from":"player","text":"You're really going there now?"},
    {"type":"message","delay":900,"from":"lena","text":"I'm just asking 😌"},
    {"type":"message","delay":900,"from":"lena","text":"Trying to understand what you like"},
    {"type":"message","delay":900,"from":"player","text":"And?"},
    {"type":"message","delay":900,"from":"lena","text":"And I want to see how you react"},
    {"type":"message","delay":900,"from":"lena","text":"Be honest with me"},
    {"type":"message","delay":900,"from":"lena","text":"If I was going to do something like that…"},
    {"type":"message","delay":900,"from":"lena","text":"Who would you want it to be with?"},
    {"type":"message","delay":900,"from":"lena","text":"Like… who would you want me to send it to?"},
    {"type":"message","delay":900,"from":"player","text":"Good question again…"},
    {"type":"choice","key":"d15_nts_target_choice","prompt":"","options":[{"id":"random_guy","text":"Probably someone I don't really know","goto":"random_path","points":{"nts":2}},{"id":"aiden","text":"Probably… {{name:aiden}}","goto":"aiden_path","points":{"nts":2}}]},
    {"type":"label","name":"random_path"},
    {"type":"message","delay":900,"from":"player","text":"I think the idea of a stranger makes it intense"},
    {"type":"message","delay":900,"from":"player","text":"And maybe safer, for the private part"},
    {"type":"message","delay":900,"from":"lena","text":"True"},
    {"type":"message","delay":900,"from":"lena","text":"Mmh…"},
    {"type":"message","delay":900,"from":"lena","text":"That's a little scary"},
    {"type":"message","delay":900,"from":"lena","text":"But also kind of exciting 😳"},
    {"type":"message","delay":900,"from":"lena","text":"But you're not afraid he'll try to steal me?"},
    {"type":"message","delay":900,"from":"player","text":"Not at all"},
    {"type":"message","delay":900,"from":"player","text":"I fully trust you"},
    {"type":"message","delay":900,"from":"player","text":"We're too good together"},
    {"type":"message","delay":900,"from":"lena","text":"Mmh… I really love you"},
    {"type":"message","delay":900,"from":"lena","text":"You're so sweet"},
    {"type":"message","delay":900,"from":"player","text":"Not as much as you"},
    {"type":"message","delay":900,"from":"player","text":"We're even"},
    {"type":"message","delay":900,"from":"lena","text":"then, why not, if we find the right person"},
    {"type":"message","delay":900,"from":"player","text":"Of course !"},
    {"type":"message","delay":900,"from":"lena","text":"It's a deal"},
    {"type":"goto","label":"after_choice"},
    {"type":"label","name":"aiden_path"},
    {"type":"message","delay":900,"from":"player","text":"{{name:aiden}}"},
    {"type":"message","delay":900,"from":"lena","text":"What??"},
    {"type":"message","delay":900,"from":"lena","text":"You didn't even hesitate"},
    {"type":"message","delay":900,"from":"player","text":"I kinda… already thought about it…"},
    {"type":"message","delay":900,"from":"lena","text":"Really??"},
    {"type":"message","delay":900,"from":"player","text":"Yeah…"},
    {"type":"message","delay":900,"from":"lena","text":"Because you already know him?"},
    {"type":"message","delay":900,"from":"player","text":"Yeah"},
    {"type":"message","delay":900,"from":"lena","text":"That's… very specific 😳"},
    {"type":"message","delay":900,"from":"lena","text":"But he's my friend too"},
    {"type":"message","delay":900,"from":"lena","text":"It might be too much"},
    {"type":"message","delay":900,"from":"lena","text":"And we don't even know if he would agree"},
    {"type":"message","delay":900,"from":"player","text":"We both know he's a real charmer"},
    {"type":"message","delay":900,"from":"player","text":"And he always looks at you like that"},
    {"type":"message","delay":900,"from":"lena","text":"Oh"},
    {"type":"message","delay":900,"from":"lena","text":"How do you know that?"},
    {"type":"message","delay":900,"from":"player","text":"I see him, he doesn't hide it"},
    {"type":"message","delay":900,"from":"lena","text":"It doesn't make you mad?"},
    {"type":"message","delay":900,"from":"player","text":"A little… but more like jealous… and excited"},
    {"type":"message","delay":900,"from":"player","text":"And proud that my girlfriend is that beautiful"},
    {"type":"message","delay":900,"from":"lena","text":"Wow… that's really sweet… and hot"},
    {"type":"message","delay":900,"from":"lena","text":"Then…"},
    {"type":"message","delay":900,"from":"lena","text":"I'll think about it"},
    {"type":"message","delay":900,"from":"player","text":"Seriously?"},
    {"type":"message","delay":900,"from":"lena","text":"Yes"},
    {"type":"message","delay":900,"from":"lena","text":"We did say we would explore this"},
    {"type":"message","delay":900,"from":"lena","text":"Why not with someone I trust?"},
    {"type":"message","delay":900,"from":"lena","text":"But you're not afraid he'll try to steal me?"},
    {"type":"message","delay":900,"from":"player","text":"Not at all"},
    {"type":"message","delay":900,"from":"player","text":"I fully trust you"},
    {"type":"message","delay":900,"from":"lena","text":"Mmh… I really love you"},
    {"type":"message","delay":900,"from":"lena","text":"You're so sweet"},
    {"type":"message","delay":900,"from":"player","text":"Not as much as you"},
    {"type":"message","delay":900,"from":"player","text":"We're even"},
    {"type":"goto","label":"after_choice"},
    {"type":"label","name":"after_choice"},
    {"type":"message","delay":900,"from":"player","text":"I'm really happy about this"},
    {"type":"message","delay":900,"from":"lena","text":"Me too"},
    {"type":"message","delay":900,"from":"lena","text":"Now I need to calm down again before bed 😭"},
    {"type":"message","delay":900,"from":"player","text":"Same problem here 😭"},
    {"type":"message","delay":900,"from":"lena","text":"Should I make it worse before bed? 😏"},
    {"type":"message","delay":900,"from":"lena","text":"Here, your picture 📸"},
    {"type":"image","delay":900,"from":"lena","image":"assets/pictures/Conversation/lena_day12_after_shower.jpg"},
    {"type":"message","delay":900,"from":"player","text":"You really want to kill me"},
    {"type":"message","delay":900,"from":"lena","text":"I would never want that!"},
    {"type":"message","delay":900,"from":"lena","text":"But keeping you awake… I'm guilty 😌"},
    {"type":"message","delay":900,"from":"lena","text":"Good night, handsome 🤍"},
    {"type":"message","delay":900,"from":"player","text":"Good night, little devil ❤️"},
    {"type":"if","condition":"all:!d15_cast_removal_summary_seen_v1,!active_character:evelyn","then":[
      {"type":"note","delay":1200,"text":"DAY 15 — After examining your leg, the doctor removed your cast. You can move more freely now, but your leg still needs rest."},
      {"type":"set_flag","key":"d15_cast_removal_summary_seen_v1","value":true}
    ]},
    {"type":"if","condition":"active_character:hailey","then":[
      {"type":"start_story","goHome":true,"startStory":"story/DAY15/DAY15_02_HAILEY_EVENING.json"}
    ],"else":[
      {"type":"if","condition":"active_character:evelyn","then":[
        {"type":"start_story","goHome":true,"startStory":"story/DAY15/DAY15_02_EVELYN_EVENING.json"}
      ],"else":[
        {"type":"time_card","text":"DAY 16","day":16,"goHome":true,"startStory":"story/DAY16/nts/DAY16_00_LENA_MORNING_NTS.json","contactId":"lena","startDelayMs":200}
      ]}
    ]}
  ]
}

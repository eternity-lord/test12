    {"type":"message","delay":850,"from":"evelyn","text":"There"},
    {"type":"message","delay":850,"from":"evelyn","text":"A smile and a kiss, then"},
    {"type":"message","delay":850,"from":"player","text":"You look beautiful"},
    {"type":"message","delay":850,"from":"player","text":"That is a wonderful reward"},
    {"type":"message","delay":850,"from":"evelyn","text":"Then I may have to send you more of them"},
    {"type":"message","delay":850,"from":"player","text":"I would not complain 😄"},
    {"type":"message","delay":850,"from":"evelyn","text":"Come eat before dinner gets cold"},
    {"type":"message","delay":850,"from":"evelyn","text":"And do not go to bed too late tonight"},
    {"type":"message","delay":850,"from":"player","text":"Yes, ma'am"},
    {"type":"message","delay":850,"from":"evelyn","text":"Good 😊"},

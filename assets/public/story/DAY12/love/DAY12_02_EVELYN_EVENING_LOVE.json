    {"type":"message","delay":850,"from":"evelyn","text":"How is that possible?"},
    {"type":"message","delay":850,"from":"player","text":"They pay me daily"},
    {"type":"message","delay":850,"from":"player","text":"So I already received money for the work I did"},
    {"type":"message","delay":850,"from":"evelyn","text":"I do not even know how to thank you for doing all this"},
    {"type":"message","delay":850,"from":"player","text":"Your smile is enough"},
    {"type":"message","delay":850,"from":"evelyn","text":"You are a flatterer"},

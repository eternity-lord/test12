    {"type":"message","delay":850,"from":"player","text":"Pretty good"},
    {"type":"message","delay":850,"from":"player","text":"I'm getting used to it"},
    {"type":"message","delay":850,"from":"player","text":"It was calmer than yesterday too"},
    {"type":"message","delay":850,"from":"player","text":"How were the groceries?"},
    {"type":"message","delay":850,"from":"evelyn","text":"I managed to buy everything we needed"},
    {"type":"message","delay":850,"from":"evelyn","text":"But there is one problem"},
    {"type":"message","delay":850,"from":"player","text":"What problem?"},
    {"type":"message","delay":850,"from":"evelyn","text":"We are almost out of money"},
    {"type":"message","delay":850,"from":"player","text":"That is not a problem"},

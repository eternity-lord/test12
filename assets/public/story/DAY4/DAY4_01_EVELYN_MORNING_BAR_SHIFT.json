  "steps": [
    {"type":"notify","delay":1200,"fromId":"evelyn","fromName":"{{name:evelyn}}","avatar":"assets/avatars/evelyn.jpg","text":"Hey","target":"conversation"},
    {"type":"message","delay":900,"from":"evelyn","text":"How are you feeling this morning?"},
    {"type":"message","delay":900,"from":"player","text":"Good and you?"},
    {"type":"message","delay":900,"from":"player","text":"Did you sleep well?"},
    {"type":"message","delay":900,"from":"player","text":"Not too much stress?"},
    {"type":"message","delay":900,"from":"evelyn","text":"It's okay"},
    {"type":"message","delay":900,"from":"evelyn","text":"The same stress as a first day I guess"},
    {"type":"message","delay":900,"from":"evelyn","text":"But I'm happy to see my colleagues!"},
    {"type":"message","delay":900,"from":"evelyn","text":"I missed them"},
    {"type":"message","delay":900,"from":"player","text":"Exactly"},
    {"type":"message","delay":900,"from":"player","text":"I'm sure they'll feel the same so don't worry"},
    {"type":"message","delay":900,"from":"evelyn","text":"Thank you sweetheart"},
    {"type":"message","delay":900,"from":"evelyn","text":"I made breakfast and it's ready"},
    {"type":"message","delay":900,"from":"evelyn","text":"Do you want me to bring it to you?"},
    {"type":"message","delay":900,"from":"player","text":"You're too kind"},
    {"type":"message","delay":900,"from":"player","text":"Yes please"},
    {"type":"message","delay":900,"from":"evelyn","text":"Are you going to take a shower this morning?"},
    {"type":"message","delay":900,"from":"player","text":"Probably"},
    {"type":"message","delay":900,"from":"player","text":"Why?"},
    {"type":"message","delay":900,"from":"evelyn","text":"If you do be careful"},
    {"type":"message","delay":900,"from":"evelyn","text":"It is a bit slippery"},
    {"type":"message","delay":900,"from":"evelyn","text":"{{name:hailey}} managed to get water everywhere"},
    {"type":"message","delay":900,"from":"player","text":"That sounds like her"},
    {"type":"message","delay":900,"from":"evelyn","text":"The store doesn't want to take her back"},
    {"type":"message","delay":900,"from":"evelyn","text":"So we will have to endure her mess until we die"},
    {"type":"message","delay":900,"from":"player","text":"Or we find some crazy guy who wants her"},
    {"type":"message","delay":900,"from":"evelyn","text":"That too"},
    {"type":"message","delay":900,"from":"evelyn","text":"Just watch your step okay"},
    {"type":"note","text":"5 MINUTES LATER"},
    {"type":"message","delay":900,"from":"evelyn","text":"I will be a bit busy this morning"},
    {"type":"message","delay":900,"from":"evelyn","text":"I need to prepare everything for going back to work"},
    {"type":"message","delay":900,"from":"evelyn","text":"My bag my clothes and a few documents"},
    {"type":"message","delay":900,"from":"evelyn","text":"So if you need something ask {{name:hailey}} or {{name:mason}}"},
    {"type":"message","delay":900,"from":"evelyn","text":"Unless it's urgent"},
    {"type":"message","delay":900,"from":"player","text":"No worries"},
    {"type":"message","delay":900,"from":"player","text":"Just do what you have to do"},
    {"type":"message","delay":900,"from":"player","text":"Thank you for taking care of me"},
    {"type":"message","delay":900,"from":"evelyn","text":"❤️"}
  ]
}
